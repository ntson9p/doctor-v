{
  "name": "doctor-v",
  "version": "0.0.0",
  "private": true,
  "description": "Ứng dụng web giúp người Việt Nam định hướng đi khám dựa trên triệu chứng.",
  "type": "module",
  "workspaces": [
    "packages/*",
    "apps/*",
    "evaluation"
  ],
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "typecheck": "tsc -p tsconfig.json",
    "test": "vitest run",
    "test:watch": "vitest",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "verify": "npm run typecheck && npm run lint && npm run test && npm run kb:check",
    "kb:check": "node packages/kb/src/cli/check.ts",
    "kb:build": "node packages/kb/src/cli/build.ts",
    "eval:check": "node evaluation/src/cli/check.ts",
    "eval": "node evaluation/src/cli/run.ts",
    "eval:tune": "node evaluation/src/cli/tune.ts",
    "play": "node evaluation/src/cli/play.ts",
    "kb:agreement": "node packages/kb/src/cli/agreement.ts",
    "kb:priors": "node packages/kb/src/cli/priors.ts",
    "agent:usage": "node tools/src/cli/usage.ts",
    "web:dev": "npm run dev -w @doctor-v/web",
    "web:build": "npm run build -w @doctor-v/web",
    "web:release": "npm run release -w @doctor-v/web",
    "web:phone": "npm run preview -w @doctor-v/web -- --host"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@types/node": "24.19.2",
    "eslint": "10.13.0",
    "fast-check": "4.10.2",
    "globals": "17.13.0",
    "prettier": "3.9.10",
    "typescript": "6.0.3",
    "typescript-eslint": "8.72.0",
    "vitest": "5.0.5"
  }
}
