---
/**
 * Shell of every page: the "Aa" text size control and the "Gọi 115" button sit in the same
 * place on every screen (docs/plan.md §3.1).
 */
import '../styles/global.css';

interface Props {
  title: string;
  description?: string;
}

const { title, description = 'Công cụ thông tin sức khỏe: gợi ý nên đi khám ở đâu, khi nào.' } = Astro.props;
const steps = [
  { scale: '1', label: 'Vừa' },
  { scale: '1.25', label: 'Lớn' },
  { scale: '1.5', label: 'Rất lớn' },
  { scale: '1.75', label: 'Lớn nhất' },
];
---

<!doctype html>
<html lang="vi">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="description" content={description} />
    <meta name="theme-color" content="#0b4f8a" />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="preload" href="/fonts/be-vietnam-pro-vietnamese-400-normal.woff2" as="font" type="font/woff2" crossorigin />
    <title>{title}</title>
    <script is:inline>
      // Apply the saved text size before the first paint (no flash of small text).
      try {
        var s = localStorage.getItem('dv.fontScale');
        if (s) document.documentElement.style.setProperty('--scale', s);
      } catch (e) {}
    </script>
  </head>
  <body>
    <a class="visually-hidden" href="#main">Đến nội dung chính</a>
    <header class="site-header">
      <div class="site-header__inner">
        <a class="site-header__brand" href="/">doctor-v</a>
        <details class="font-size">
          <summary class="btn" aria-label="Cỡ chữ">Aa</summary>
          <div class="font-size__panel">
            <p><strong>Cỡ chữ</strong></p>
            <div class="font-size__steps">
              {steps.map((s) => (
                <button type="button" class="btn" data-font-scale={s.scale} aria-pressed="false">
                  {s.label}
                </button>
              ))}
            </div>
            <button type="button" class="btn btn--link" data-font-reset>Đặt lại cỡ chữ</button>
          </div>
        </details>
        <a class="btn btn-115" href="tel:115">
          <svg aria-hidden="true" width="20" height="20" viewBox="0 0 24 24" fill="currentColor">
            <path d="M6.6 10.8a15.1 15.1 0 0 0 6.6 6.6l2.2-2.2a1 1 0 0 1 1-.25 11.4 11.4 0 0 0 3.6.57 1 1 0 0 1 1 1V20a1 1 0 0 1-1 1A17 17 0 0 1 3 4a1 1 0 0 1 1-1h3.5a1 1 0 0 1 1 1c0 1.25.2 2.45.57 3.6a1 1 0 0 1-.25 1z"></path>
          </svg>
          Gọi 115
        </a>
      </div>
    </header>
    <main id="main" class="page">
      <slot />
    </main>
    <footer class="site-footer">
      <p>
        Công cụ thông tin sức khỏe, không chẩn đoán bệnh và không thay thế việc khám bệnh. Nội dung chưa được bác sĩ
        thẩm định. Mọi câu trả lời chỉ được xử lý trên máy của bạn.
      </p>
      <p><a href="/gioi-thieu">Giới thiệu và nguồn</a> · <a href="/cai-dat">Cài đặt</a></p>
    </footer>
    <script is:inline>
      (function () {
        var root = document.documentElement;
        function current() {
          return root.style.getPropertyValue('--scale') || '1';
        }
        function mark() {
          document.querySelectorAll('[data-font-scale]').forEach(function (b) {
            b.setAttribute('aria-pressed', String(b.getAttribute('data-font-scale') === current()));
          });
        }
        function set(scale) {
          root.style.setProperty('--scale', scale);
          try {
            if (scale === '1') localStorage.removeItem('dv.fontScale');
            else localStorage.setItem('dv.fontScale', scale);
          } catch (e) {}
          mark();
        }
        document.addEventListener('click', function (e) {
          var t = e.target instanceof Element ? e.target.closest('[data-font-scale],[data-font-reset]') : null;
          if (!t) return;
          set(t.hasAttribute('data-font-reset') ? '1' : t.getAttribute('data-font-scale'));
        });
        mark();
      })();
    </script>
  </body>
</html>
